{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "compute-engine",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "compute-engine": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "functions": {
    "backend/main.py": { "maxDuration": 60 }
  }
}
